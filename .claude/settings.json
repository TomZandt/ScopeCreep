{
  "permissions": {
    "allow": [
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git branch -D:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git push -q origin --delete:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
